        { "title": "List executions", "method": "GET", "path": "/api/automation/:flowId/executions", "description": "Execution logs for a flow.", "payload": null },
        { "title": "Get execution", "method": "GET", "path": "/api/automation/executions/:executionId", "description": "Single execution detail.", "payload": null }
