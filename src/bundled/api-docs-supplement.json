        { "title": "Create flow", "method": "POST", "path": "/api/automation", "description": "Create flow with nodes, connections, triggers.", "payload": { "name": "My flow", "nodes": [], "connections": [], "triggers": [{ "event_type": "message_received", "conditions": {} }] } },
        { "title": "Update flow", "method": "PUT", "path": "/api/automation/:flowId", "description": "Update flow graph or metadata.", "payload": null },
        { "title": "Toggle flow", "method": "PATCH", "path": "/api/automation/:flowId/toggle", "description": "Activate or deactivate.", "payload": { "is_active": true } },
        { "title": "Test flow", "method": "POST", "path": "/api/automation/:flowId/test", "description": "Run flow with test_data.", "payload": { "test_data": { "senderNumber": "919876543210", "contactId": "" } } },
