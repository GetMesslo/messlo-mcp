  "faqs": [
    {
      "question": "How do I send an approved WhatsApp template?",
      "answer": "POST /api/whatsapp/send with messageType template, template_name (or template_id), templateVariables, contact_no, and whatsapp_phone_number."
    },
    {
      "question": "How do automations save data to CRM?",
      "answer": "Use update_contact nodes with field_key matching custom field names from GET /api/custom-fields. Use add_to_segment with segment_id from GET /api/segments."
    },
    {
      "question": "What form_id for form_flow automation nodes?",
      "answer": "Call messlo_get_form and use data.flow.flow_id (Meta Flow id), not the MongoDB form _id."
    },
    {
      "question": "How do I set up keyword auto-replies?",
      "answer": "Use messlo_create_message_bot with keywords and reply_content for simple text replies."
    }
  ]
